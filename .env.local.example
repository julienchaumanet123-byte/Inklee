# =============================================================================
# Inklee - Variables d'environnement
# Copie ce fichier vers .env.local et remplis avec tes vraies clés
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Inklee

# --- Supabase ---
# https://app.supabase.com → ton projet → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Stripe ---
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# IDs des produits Stripe (à créer dans le dashboard puis recopier ici)
NEXT_PUBLIC_STRIPE_PRICE_STARTER=price_placeholder_starter
NEXT_PUBLIC_STRIPE_PRICE_PRO=price_placeholder_pro

# --- Resend (emails) ---
# https://resend.com/api-keys
RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL=hello@inklee.fr

# --- Twilio (SMS rappels) ---
# https://console.twilio.com
TWILIO_ACCOUNT_SID=ACplaceholder
TWILIO_AUTH_TOKEN=placeholder
TWILIO_FROM_NUMBER=+33000000000
